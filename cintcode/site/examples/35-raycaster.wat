    (i32.store (i32.add (i32.shl (global.get $G) (i32.const 2)) (i32.const 4)) (i32.add (global.get $TB) (i32.const 9))) ;; G!1
  )
  (func $stat_words (export "stat_words") (result i32)
    (i32.const 77))
  (func $fn_count (export "fn_count") (result i32)
    (i32.const 10))
)
 ;; end module
